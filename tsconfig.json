{
    "compilerOptions": {
        "target": "ES2022",
        "lib": [
            "ES2022",
            "DOM"
        ],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "types": [
            "cypress",
            "node"
        ],
        "strict": true,
        "noEmit": true,
    },
    "include": [
        "cypress/**/*.ts",
        "cypress.config.ts"
    ]
}