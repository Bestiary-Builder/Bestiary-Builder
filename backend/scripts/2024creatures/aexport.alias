<drac2>
n = "\n"
args_raw = """&*&""".strip()

try:
    pfx = ctx.prefix
except:
    pfx = "!"

SAVE_GVAR_ID = "835e9e6-7eb7-45a9-b30e-9219f58ce03f"
GVAR_COMMAND_LIMIT = 95000
PART_LIMIT = 8500
MAX_PARTS_TO_CLEAR = 30

def esc(s):
    return str(s).replace("\\", "\\\\").replace('"', '\\"').replace("\n", "\\n")

def q(s):
    return str(s).replace("\\", "\\\\").replace('"', '\\"')

def emb(title, desc, color="gold"):
    return f'{pfx}embed -title "{esc(title)}" -desc "{esc(desc)}" -color {color}'

def tn(v):
    try:
        return typeof(v)
    except:
        try:
            return str(type(v))
        except:
            return ""

def is_list(v):
    return "list" in str(tn(v)).lower()

def is_dict(v):
    return "dict" in str(tn(v)).lower()

def is_str(v):
    return "str" in str(tn(v)).lower()

def title_case_name(s):
    words = str(s).strip().split()
    small = ["a", "an", "and", "as", "at", "but", "by", "for", "from", "in", "into", "nor", "of", "on", "or", "the", "to", "with"]
    out = []

    for i, w in enumerate(words):
        lw = w.lower()

        if i > 0 and lw in small:
            out.append(lw)
        elif len(w) > 1:
            out.append(w[0].upper() + w[1:].lower())
        else:
            out.append(w.upper())

    return " ".join(out)

def quoted_args(raw):
    raw = str(raw)
    out = []
    cur = ""
    inq = False
    escn = False

    for ch in raw:
        if escn:
            cur += ch
            escn = False
        elif ch == "\\":
            escn = True
        elif ch == '"':
            if inq:
                out.append(cur.strip())
                cur = ""
                inq = False
            else:
                inq = True
                cur = ""
        else:
            if inq:
                cur += ch

    return [x for x in out if str(x).strip()]

def remove_flag_with_value(raw, flag_names):
    parts = str(raw).split()
    found = ""
    i = 0
    out = []

    while i < len(parts):
        p = parts[i]

        if p in flag_names:
            if i + 1 < len(parts):
                found = parts[i + 1]
                i += 2
                continue

        out.append(p)
        i += 1

    return {
        "raw": " ".join(out).strip(),
        "value": found
    }

def textify(v):
    if v == None:
        return ""

    if is_str(v):
        return str(v)

    if is_list(v):
        parts = []

        try:
            for x in v:
                tx = textify(x)

                if tx:
                    parts.append(tx)
        except:
            pass

        return n.join(parts)

    if is_dict(v):
        for k in ["description", "desc", "text", "entry"]:
            try:
                if k in v and v[k] != None:
                    return textify(v[k])
            except:
                pass

        try:
            if "entries" in v and v["entries"] != None:
                return textify(v["entries"])
        except:
            pass

        try:
            if "items" in v and v["items"] != None:
                return textify(v["items"])
        except:
            pass

        return ""

    return str(v)

def first_text_from_automation(auto):
    if not auto:
        return ""

    if is_dict(auto):
        try:
            if auto.get("type") == "text":
                return auto.get("text", "")
        except:
            pass

        try:
            if "automation" in auto:
                return first_text_from_automation(auto["automation"])
        except:
            pass

    if is_list(auto):
        try:
            for e in auto:
                found = first_text_from_automation(e)

                if found:
                    return found
        except:
            pass

    return ""

def clean_name_from_text(txt, fallback="Unknown"):
    s = str(txt).strip()

    if not s:
        return fallback

    try:
        idx = s.index(".")
    except:
        idx = -1

    if idx > 0 and idx <= 80:
        return s[:idx].strip()

    if len(s) <= 80:
        return s

    return fallback

def get_entry_name(entry, fallback="Unknown"):
    if is_dict(entry):
        for k in ["name", "title"]:
            try:
                if k in entry and entry[k]:
                    return str(entry[k])
            except:
                pass

    if is_str(entry):
        return clean_name_from_text(entry, fallback)

    return fallback

def get_entry_description(entry):
    if is_dict(entry):
        for k in ["description", "desc", "text", "entries", "entry", "items"]:
            try:
                if k in entry and entry[k] != None:
                    return textify(entry[k])
            except:
                pass

        try:
            if "automation" in entry:
                return first_text_from_automation(entry["automation"])
        except:
            pass

        return ""

    return textify(entry)

def get_entry_automation(entry):
    if not is_dict(entry):
        return None

    for k in ["automation", "auto"]:
        try:
            if k in entry and entry[k] != None:
                if entry[k]:
                    return entry[k]
        except:
            pass

    return None

def activation_value(entry):
    if not is_dict(entry):
        return ""

    for k in ["activation_type", "activationType", "activation"]:
        try:
            if k in entry:
                return entry[k]
        except:
            pass

    return ""

def category_from_activation_type(v, fallback="actions"):
    sv = str(v).lower().strip()

    if sv == "1" or sv == "action":
        return "actions"

    if sv == "2" or "bonus" in sv:
        return "bonus"

    if sv == "3" or "reaction" in sv:
        return "reactions"

    if sv == "4" or sv == "9" or "legendary" in sv:
        return "legendary"

    if sv == "5" or sv == "11" or "lair" in sv:
        return "lair"

    if sv == "6" or "mythic" in sv:
        return "mythic"

    if "regional" in sv:
        return "regional"

    if sv in ["0", "7", "8", "10", "12", "other", "special", "none"]:
        return "features"

    return fallback

def category_from_name(name, fallback="actions"):
    low = str(name).lower()

    if "bonus action" in low:
        return "bonus"

    if "reaction" in low:
        return "reactions"

    if "legendary action" in low:
        return "legendary"

    if "lair action" in low:
        return "lair"

    if "mythic action" in low:
        return "mythic"

    if "regional effect" in low:
        return "regional"

    return fallback

def category_from_description(name, desc, fallback="actions"):
    low = (str(name) + " " + str(desc)).lower()

    if fallback == "actions":
        if "aura" in low and "melee attack roll" not in low:
            return "features"

        if "is surrounded by" in low:
            return "features"

        if "while underwater" in low:
            return "features"

    return fallback

def make_feature_entry(name, description="", automation=None):
    if not name:
        name = "Unknown"

    if not description:
        description = ""

    if not automation:
        automation = None

    return {
        "name": str(name),
        "description": str(description),
        "automation": automation
    }

def merge_entry(lst, entry):
    name = str(entry.get("name", "Unknown")).lower().strip()

    for existing in lst:
        try:
            ename = str(existing.get("name", "Unknown")).lower().strip()

            if ename == name:
                if not existing.get("description", "") and entry.get("description", ""):
                    existing["description"] = entry.get("description", "")

                if not existing.get("automation", None) and entry.get("automation", None):
                    existing["automation"] = entry.get("automation", None)

                return
        except:
            pass

    lst.append(entry)

def add_entry_to_category(out, category, name, desc="", automation=None):
    if category not in out:
        category = "actions"

    merge_entry(out[category], make_feature_entry(name, desc, automation))

def looks_like_nested_automation_object(v):
    if not is_dict(v):
        return False

    has_auto = False
    has_nameish = False

    try:
        has_auto = "automation" in v
    except:
        has_auto = False

    try:
        has_nameish = "name" in v or "_v" in v or "activation_type" in v or "activationType" in v
    except:
        has_nameish = False

    return has_auto and has_nameish

def nested_automation_objects(auto):
    out = []

    if not auto:
        return out

    if is_dict(auto):
        if looks_like_nested_automation_object(auto):
            out.append(auto)

        return out

    if is_list(auto):
        try:
            for e in auto:
                if looks_like_nested_automation_object(e):
                    out.append(e)
        except:
            pass

    return out

def process_entry(out, entry, fallback_category="actions", fallback_name="Unknown"):
    if entry == None:
        return

    if is_list(entry):
        try:
            for e in entry:
                process_entry(out, e, fallback_category, fallback_name)
        except:
            pass

        return

    if is_str(entry):
        desc = str(entry)
        name = clean_name_from_text(desc, fallback_name)
        cat = category_from_description(name, desc, fallback_category)
        add_entry_to_category(out, cat, name, desc, None)
        return

    if not is_dict(entry):
        return

    outer_name = get_entry_name(entry, fallback_name)
    outer_desc = get_entry_description(entry)
    outer_auto = get_entry_automation(entry)

    nested = nested_automation_objects(outer_auto)

    if nested:
        for sub in nested:
            sub_name = get_entry_name(sub, outer_name)
            sub_desc = get_entry_description(sub)

            try:
                sub_auto = sub.get("automation", None)
            except:
                sub_auto = None

            if not sub_desc:
                sub_desc = first_text_from_automation(sub_auto)

            if not sub_desc:
                sub_desc = outer_desc

            sub_cat = category_from_activation_type(activation_value(sub), fallback_category)
            sub_cat = category_from_name(sub_name, sub_cat)
            sub_cat = category_from_description(sub_name, sub_desc, sub_cat)

            add_entry_to_category(out, sub_cat, sub_name, sub_desc, sub_auto)

        return

    cat = category_from_activation_type(activation_value(entry), fallback_category)
    cat = category_from_name(outer_name, cat)

    if not outer_desc:
        outer_desc = first_text_from_automation(outer_auto)

    cat = category_from_description(outer_name, outer_desc, cat)

    add_entry_to_category(out, cat, outer_name, outer_desc, outer_auto)

def make_creature_block(c):
    out = {
        "features": [],
        "actions": [],
        "bonus": [],
        "reactions": [],
        "legendary": [],
        "lair": [],
        "mythic": [],
        "regional": []
    }

    try:
        for atk in c.attacks:
            raw = {}
            name = "Unknown"

            try:
                name = str(atk.name)
            except:
                pass

            try:
                raw = load_json(dump_json(atk.raw).replace(', "meta": []', ''))
            except:
                raw = {}

            if raw:
                try:
                    if "name" not in raw:
                        raw["name"] = name
                except:
                    pass

                try:
                    if "activation_type" not in raw:
                        raw["activation_type"] = atk.activation_type
                except:
                    pass

                try:
                    if "activationType" not in raw:
                        raw["activationType"] = atk.activationType
                except:
                    pass

                try:
                    if "activation" not in raw:
                        raw["activation"] = atk.activation
                except:
                    pass

                process_entry(out, raw, "actions", name)
            else:
                add_entry_to_category(out, "actions", name, "", None)
    except:
        pass

    return out

def clean_json_noise(js):
    null_keys = "duration verb level attackBonus castingMod parent save_as defaultDC defaultAttackBonus defaultCastingMod desc effects".split()
    false_keys = "end conc target_self overheal hidden cantripScale fixedValue tick_on_caster stacking".split()
    empty_list_keys = "miss success attacks buttons onFalse".split()

    for key in null_keys:
        js = js.replace(f', "{key}": null', '')
        js = js.replace(f'"{key}": null, ', '')
        js = js.replace(f'"{key}": null', '')

    for key in false_keys:
        js = js.replace(f', "{key}": false', '')
        js = js.replace(f'"{key}": false, ', '')
        js = js.replace(f'"{key}": false', '')

    for key in empty_list_keys:
        js = js.replace(f', "{key}": []', '')
        js = js.replace(f'"{key}": [], ', '')
        js = js.replace(f'"{key}": []', '')

    js = js.replace("{, ", "{")
    js = js.replace(", }", "}")
    js = js.replace("[, ", "[")

    return js

def split_text(txt, size):
    out = []
    i = 0

    while i < len(txt):
        out.append(txt[i:i + size])
        i += size

    return out

def fallback_to_uvars(js, reason):
    parts = split_text(js, PART_LIMIT)

    for i in range(1, MAX_PARTS_TO_CLEAR + 1):
        try:
            set_uvar(f"creature_part_{i}", "")
        except:
            pass

    for i, part in enumerate(parts, 1):
        set_uvar(f"creature_part_{i}", part)

    index_lines = []
    index_lines.append(f"Could not create/edit direct GVAR: {reason}")
    index_lines.append(f"Length: {len(js)} characters")
    index_lines.append(f"Parts: {len(parts)}")
    index_lines.append("")
    index_lines.append("Copy these in order:")

    for i in range(1, len(parts) + 1):
        index_lines.append(f"{pfx}uvar creature_part_{i}")

    try:
        set_uvar("creature_index", n.join(index_lines))
    except:
        pass

    return emb("Gimme: fallback used", f"Too large for direct gvar create/edit. Use `{pfx}uvar creature_index`.", "red")

def add_monsters(raw):
    names = quoted_args(raw)
    lines = []

    for raw_name in names:
        query = str(raw_name).strip()

        if not query:
            continue

        display = title_case_name(query)
        lines.append(f'{pfx}init madd "{q(query)}" -name "{q(display)}"')

    if len(lines) == 0:
        return emb("Gimme", "No monster names found. Use quotes, like `!gimme \"stone golem\" \"aboleth\"`.", "red")

    return "multiline " + n.join(lines)

def collect_all(target_gvar=""):
    payload = {}

    try:
        for c in combat().combatants:
            payload[str(c.name)] = make_creature_block(c)
    except:
        pass

    if len(payload) == 0:
        return emb("Gimme", "No combatants found to export.", "red")

    if target_gvar:
        try:
            existing_raw = get_gvar(target_gvar)
            existing = {}

            if existing_raw and str(existing_raw).strip():
                existing = load_json(existing_raw)

            if not is_dict(existing):
                existing = {}

            for k in payload:
                existing[k] = payload[k]

            js = clean_json_noise(dump_json(existing))
            cmd = f"{pfx}gvar edit {target_gvar} {js}"
        except:
            js = clean_json_noise(dump_json(payload))
            cmd = f"{pfx}gvar edit {target_gvar} {js}"
    else:
        js = clean_json_noise(dump_json(payload))
        cmd = f"{pfx}gvar create {js}"

    if len(cmd) <= GVAR_COMMAND_LIMIT:
        return "multiline " + cmd

    return fallback_to_uvars(js, f"command length {len(cmd)} over limit {GVAR_COMMAND_LIMIT}")

raw = args_raw.strip()

gvar_result = remove_flag_with_value(raw, ["--gvar", "-g"])
raw = gvar_result["raw"]
target_gvar = gvar_result["value"]

if not target_gvar:
    target_gvar = SAVE_GVAR_ID

if not raw or raw.lower() == "help":
    return emb(
        "Gimme",
        f'Add monsters:\n`{pfx}gimme "stone golem" "adult bronze dragon" "banshee" "beholder" "aboleth"`\n\nCollect everything in init into the saved GVAR:\n`{pfx}gimme all`\n\nSaved GVAR:\n`{SAVE_GVAR_ID}`\n\nOverride GVAR:\n`{pfx}gimme all --gvar <gvar id>`',
        "gold"
    )

if not combat():
    return emb("Gimme", "You are not in initiative.", "red")

if raw.startswith('"'):
    return add_monsters(raw)

if raw.lower() == "all":
    return collect_all(target_gvar)

return emb(
    "Gimme",
    f'Use quoted monster names to add, or `{pfx}gimme all` to collect.\n\nExample:\n`{pfx}gimme "stone golem" "aboleth"`',
    "red"
)
</drac2>